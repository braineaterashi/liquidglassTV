<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Ambient Soft Glow / Shadow for depth -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="22dp" />
            <solid android:color="#1A000000" />
        </shape>
    </item>

    <!-- Liquid Glass Ultra-Translucent Crystalline Body -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="22dp" />
            <gradient
                android:angle="135"
                android:startColor="#33FFFFFF"
                android:centerColor="#141E283C"
                android:endColor="#240B0F1A"
                android:type="linear" />
            <stroke
                android:width="1.5dp"
                android:color="#66FFFFFF" />
        </shape>
    </item>

    <!-- Top Specular Rim Reflection (Thick Curved Liquid Glass Highlight) -->
    <item
        android:top="1dp"
        android:left="2dp"
        android:right="2dp"
        android:bottom="36dp">
        <shape android:shape="rectangle">
            <corners
                android:topLeftRadius="21dp"
                android:topRightRadius="21dp"
                android:bottomLeftRadius="0dp"
                android:bottomRightRadius="0dp" />
            <gradient
                android:angle="270"
                android:startColor="#59FFFFFF"
                android:endColor="#00FFFFFF"
                android:type="linear" />
        </shape>
    </item>
</layer-list>
