<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/callBannerRoot"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="16dp"
    android:paddingEnd="24dp"
    android:paddingTop="12dp"
    android:paddingBottom="12dp"
    android:background="@drawable/bg_call_banner"
    android:elevation="20dp">

    <!-- Glowing Emerald Phone Icon Badge -->
    <FrameLayout
        android:id="@+id/callIconBadge"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginEnd="14dp"
        android:background="@drawable/bg_call_icon_badge">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="📞"
            android:textSize="20sp" />
    </FrameLayout>

    <!-- Caller Info -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/callTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Incoming Call"
            android:textColor="#FFFFFFFF"
            android:textSize="17sp"
            android:fontFamily="@font/outfit_medium"
            android:singleLine="true"
            android:ellipsize="end"
            android:maxWidth="280dp" />

        <TextView
            android:id="@+id/callSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="iPhone • Ringing..."
            android:textColor="#B0FFFFFF"
            android:textSize="12sp"
            android:fontFamily="@font/outfit_light"
            android:letterSpacing="0.04"
            android:singleLine="true"
            android:ellipsize="end"
            android:maxWidth="280dp" />
    </LinearLayout>
</LinearLayout>